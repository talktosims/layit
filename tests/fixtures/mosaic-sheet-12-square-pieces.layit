    "width": 12,
    "height": 12,
    "grout": 0.125,
    "orientation": "pointy",
    "pattern": 0,
    "subShape": "square",
    "subW": 2,
    "subH": 2,
    "subGr": 0.125,
    "mosaicFile": "sheet-outlines",
    "mosaicPreview": "sub-tile-field"
  },
  "voids": [],
